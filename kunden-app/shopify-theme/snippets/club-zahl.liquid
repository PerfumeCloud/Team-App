{%- comment -%}
  Ganze Zahl mit Tausenderpunkt, z. B. 1520 → „1.520“: {% render 'club-zahl', n: punkte %}
{%- endcomment -%}
{%- liquid
  assign n = n | default: 0 | plus: 0 | round
  assign text = ''
  assign minus = false
  if n < 0
    assign minus = true
    assign n = 0 | minus: n
  endif
  for i in (1..6)
    if n >= 1000
      assign teil = n | modulo: 1000 | plus: 1000 | append: '' | slice: 1, 3
      assign text = '.' | append: teil | append: text
      assign n = n | divided_by: 1000 | floor
    else
      assign text = n | append: text
      break
    endif
  endfor
  if minus
    assign text = '−' | append: text
  endif
  echo text
-%}
