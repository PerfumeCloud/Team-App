{%- comment -%}
  Perfume Cloud Club im Kopf: Punktestand der Mitglieder („240 P“, bei vollem Warenkorb „+59“ dazu),
  Nicht-Mitglieder sehen nur bei vollem Warenkorb, wie viele Punkte sie im Club bekämen.
  Lädt außerdem club.css, die Club-Daten und club.js – deshalb reicht eine Zeile im Theme:
  in sections/kopf.liquid vor dem Link zum Kundenkonto  {% render 'club-kopf' %}
{%- endcomment -%}
{%- liquid
  assign club = shop.metafields.club.programm.value
  assign club_mitglied = false
  if customer and customer.tags contains 'club'
    assign club_mitglied = true
  endif
  assign club_stand = 0
  if club_mitglied
    assign club_stand = customer.metafields.club.punkte.value | default: 0
  endif
-%}
{{ 'club.css' | asset_url | stylesheet_tag }}
{%- render 'club-daten' -%}
<script src="{{ 'club.js' | asset_url }}" defer></script>
{%- if club != blank -%}
  {%- if club_mitglied -%}
    <a class="dock-punkt dock-text club-kopf" href="{{ club.app_url | default: 'https://app.perfumecloud.de' }}" data-club-punkte="kopf" aria-label="Perfume Cloud Club: {{ club_stand }} Punkte"><span class="club-kopf-punkt" aria-hidden="true"></span><span><span data-club-stand>{{ club_stand }}</span>&nbsp;P</span><span class="club-kopf-plus" data-club-plus hidden></span></a>
  {%- else -%}
    <a class="dock-punkt dock-text club-kopf" href="{{ routes.cart_url }}" data-club-punkte="kopf" hidden><span class="club-kopf-punkt" aria-hidden="true"></span><span>Club</span><span class="club-kopf-plus" data-club-plus hidden></span></a>
  {%- endif -%}
{%- endif -%}
