{%- comment -%}
  So funktioniert der Perfume Cloud Club. Ab Club 1.4 gibt es dafür den Abschnitt „Club auf der Startseite“
  (club-start) mit Metallkarten und eigenem Stand; dieser Abschnitt bleibt für bestehende Seiten erhalten. Alle Zahlen kommen aus dem Shop-Metafeld club.programm, das die Club-App
  nach jeder Änderung im Admin-Bereich neu schreibt: Punkte je Euro, Stufen und Vorteile, Boni, Verfall, Aktionen.
  Im Theme muss deshalb nichts von Hand angepasst werden.
{%- endcomment -%}
{%- liquid
  assign prog = shop.metafields.club.programm.value
  assign mitglied = false
  if customer and customer.tags contains 'club'
    assign mitglied = true
  endif
  assign meine = ''
  if mitglied and prog.tiers_enabled
    assign meine = customer.metafields.club.stufe.value | default: 'bronze'
  endif
  assign app = prog.app_url | default: 'https://app.perfumecloud.de'

  assign jetzt = 'now' | date: '%s' | plus: 0
  assign aktion = nil
  assign aktion_faktor = 1
  assign naechste = nil
  assign naechste_beginn = 0
  for a in prog.promos
    assign beginn = a.start | date: '%s' | plus: 0
    assign ende = a.end | date: '%s' | plus: 0
    if beginn <= jetzt and jetzt < ende and a.factor > aktion_faktor
      assign aktion = a
      assign aktion_faktor = a.factor
    elsif beginn > jetzt
      if naechste == nil or beginn < naechste_beginn
        assign naechste = a
        assign naechste_beginn = beginn
      endif
    endif
  endfor

  assign grund = prog.rate | default: 1
  if prog.tiers_enabled and prog.tiers.size > 0
    assign grund = prog.tiers.first.rate
  endif
  assign grund_ganz = grund | floor
  if grund_ganz == grund
    assign grund_text = grund_ganz
  else
    assign grund_text = grund | append: '' | replace: '.', ','
  endif
-%}
{%- if prog != blank -%}
<section class="club-regeln" id="club" aria-labelledby="h-club-{{ section.id }}">
  <div class="club-regeln-innen">
    <div class="club-kopfzeile">
      <p class="club-label club-marke-name" translate="no">{{ prog.name | default: 'Perfume Cloud Club' | escape }}</p>
      <h2 id="h-club-{{ section.id }}">{{ section.settings.titel }}</h2>
      {%- if section.settings.text != blank -%}<p>{{ section.settings.text }}</p>{%- endif -%}
    </div>

    {%- liquid
      assign band = aktion | default: naechste
      if band
        assign f_ganz = band.factor | floor
        if f_ganz == band.factor
          assign f_text = f_ganz
        else
          assign f_text = band.factor | append: '' | replace: '.', ','
        endif
        case f_ganz
          when 2
            assign f_wort = 'Doppelte'
          when 3
            assign f_wort = 'Dreifache'
          when 4
            assign f_wort = 'Vierfache'
          else
            assign f_wort = f_text | append: '-fache'
        endcase
        if f_ganz != band.factor
          assign f_wort = f_text | append: '-fache'
        endif
      endif
    -%}
    {%- if aktion -%}
      <p class="club-aktion-band"><span class="club-punkte-aktion">{{ f_text }}×</span><span><b>{{ f_wort }} Punkte</b> zur Aktion „{{ aktion.name | escape }}“, noch bis {{ aktion.end | date: '%d.%m.%Y, %H:%M' }} Uhr</span></p>
    {%- elsif naechste -%}
      <p class="club-aktion-band"><span>Bald: <b>{{ f_text }}× Punkte</b> zur Aktion „{{ naechste.name | escape }}“ ab {{ naechste.start | date: '%d.%m.%Y' }}</span></p>
    {%- endif -%}

    <ol class="club-schritte">
      <li class="club-schritt">
        <span class="nr" aria-hidden="true">01</span>
        <p class="club-schritt-titel">Punkte sammeln</p>
        <p>Für jeden Euro Einkaufswert bekommst du {{ grund_text }} {% if grund == 1 %}Punkt{% else %}Punkte{% endif %}{% if prog.tiers_enabled and prog.tiers.size > 1 %}, ab {{ prog.tiers[1].name | escape }} mehr{% endif %}. Sie stehen sofort nach der Bestellung im Konto{% if prog.wait_days > 0 %} und sind nach {{ prog.wait_days }} Tagen einlösbar{% endif %}.</p>
      </li>
      <li class="club-schritt">
        <span class="nr" aria-hidden="true">02</span>
        <p class="club-schritt-titel">Im Warenkorb einlösen</p>
        <p>{{ prog.redeem_points }} Punkte sind {% render 'club-euro', cents: prog.redeem_cents %} Rabatt. Du löst sie direkt im Warenkorb ein, ohne Code{% if prog.max_cents > 0 %}, bis {% render 'club-euro', cents: prog.max_cents %} je Bestellung{% endif %}.</p>
      </li>
      <li class="club-schritt">
        <span class="nr" aria-hidden="true">03</span>
        <p class="club-schritt-titel">Bonus obendrauf</p>
        <p>{% if prog.welcome_points > 0 %}{{ prog.welcome_points }} Punkte zum Beitritt, dazu {% endif %}Punkte zum Geburtstag{% if prog.review_once %} und für deine erste Bewertung{% else %} und für Bewertungen{% endif %}{% if prog.referral %}, dazu Punkte, wenn Freunde über deinen Link bestellen{% endif %}.</p>
      </li>
    </ol>

    {%- if section.settings.stufen and prog.tiers_enabled and prog.tiers.size > 0 -%}
      <p class="club-label">Stufen</p>
      {%- render 'club-stufen', prog: prog, meine: meine -%}
    {%- endif -%}

    {%- if section.settings.boni -%}
      <div class="club-boni">
        <p class="club-label">Bonuspunkte</p>
        <ul>
          {%- if prog.welcome_points > 0 -%}<li><span>Beitritt zum Club</span><b>{{ prog.welcome_points }} Punkte</b></li>{%- endif -%}
          {%- if prog.bonus.birthday > 0 -%}<li><span>Zum Geburtstag</span><b>{{ prog.bonus.birthday }} Punkte</b></li>{%- endif -%}
          {%- if prog.bonus.newsletter > 0 -%}<li><span>Newsletter-Anmeldung</span><b>{{ prog.bonus.newsletter }} Punkte</b></li>{%- endif -%}
          {%- if prog.bonus.review > 0 -%}<li><span>{% if prog.review_once %}Deine erste Bewertung{% else %}Bewertung eines Dufts{% endif %}</span><b>{{ prog.bonus.review }} Punkte</b></li>{%- endif -%}
          {%- if prog.referral and prog.bonus.referrer > 0 -%}<li><span>Freund bestellt über deinen Link, für dich</span><b>{{ prog.bonus.referrer }} Punkte</b></li>{%- endif -%}
          {%- if prog.referral and prog.bonus.referred > 0 -%}<li><span>Für deinen Freund</span><b>{{ prog.bonus.referred }} Punkte</b></li>{%- endif -%}
        </ul>
      </div>
    {%- endif -%}

    <p class="club-klein">
      Punkte gibt es auf den Warenwert nach Rabatten, ohne Versand. Bei Storno oder Rückgabe werden sie wieder abgezogen.
      {%- if prog.expiry_months > 0 %} Nicht eingelöste Punkte verfallen {{ prog.expiry_months }} Monate nach der Gutschrift.{% endif -%}
      {%- if section.settings.bedingungen != blank %} <a href="{{ section.settings.bedingungen }}">Teilnahmebedingungen</a>{% endif -%}
    </p>

    <div class="club-aktion-knopf">
      {%- if mitglied -%}
        <a class="hb hb-klein" href="{{ app }}"><span class="hb-text">Zum Club</span><span class="hb-hover" aria-hidden="true"><span>Zum Club</span><svg aria-hidden="true"><use href="#i-person"/></svg></span><span class="hb-punkt" aria-hidden="true"></span></a>
        {%- assign p = customer.metafields.club.punkte.value | default: 0 -%}<span class="leise">Du hast {% render 'club-zahl', n: p %} {% if p == 1 %}Punkt{% else %}Punkte{% endif %}.</span>
      {%- else -%}
        <a class="hb hb-klein" href="{{ app }}"><span class="hb-text">Kostenlos beitreten</span><span class="hb-hover" aria-hidden="true"><span>Kostenlos beitreten</span><svg aria-hidden="true"><use href="#i-person"/></svg></span><span class="hb-punkt" aria-hidden="true"></span></a>
        <span class="leise">Mit deinem Kundenkonto, in einer Minute.</span>
      {%- endif -%}
    </div>
  </div>
</section>
{%- elsif request.design_mode -%}
<section class="club-regeln"><p class="club-klein">Die Club-Regeln erscheinen hier, sobald die Club-App mit dem Shop verbunden ist (Shop-Metafeld club.programm).</p></section>
{%- endif -%}

{% schema %}
{
  "name": "Club-Regeln",
  "settings": [
    { "type": "inline_richtext", "id": "titel", "label": "Überschrift", "default": "Sammeln, einlösen, <em>aufsteigen</em>" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Im Perfume Cloud Club bekommst du für jede Bestellung Punkte und löst sie direkt im Warenkorb ein." },
    { "type": "checkbox", "id": "stufen", "label": "Stufen zeigen", "default": true },
    { "type": "checkbox", "id": "boni", "label": "Bonuspunkte zeigen", "default": true },
    { "type": "url", "id": "bedingungen", "label": "Link zu den Teilnahmebedingungen" }
  ],
  "presets": [{ "name": "Club-Regeln" }]
}
{% endschema %}
